#version 450
// Takes the noise out of the occlusion, keeping to pixels on the same surface so it doesn't bleed over edges.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D result;
layout(set = 0, binding = 1) uniform sampler2D raw;
layout(set = 0, binding = 2) uniform sampler2D sceneDepth;

#define OCCLUSION_SET 0
#define OCCLUSION_BINDING 3
#include "OcclusionData.glsl"

void main()
{
    ivec2 size = imageSize(result);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    ivec2 screen = textureSize(sceneDepth, 0);
    float here = alongView(texelFetch(sceneDepth, min(pixel * 2, screen - 1), 0).r);
    float sum = 0.0;
    float total = 0.0;
    for (int y = -2; y <= 2; y++)
    {
        for (int x = -2; x <= 2; x++)
        {
            ivec2 at = clamp(pixel + ivec2(x, y), ivec2(0), size - 1);
            float along = alongView(texelFetch(sceneDepth, min(at * 2, screen - 1), 0).r);
            float weight = exp(-abs(along - here) / (here * 0.02 + 0.05)) * (1.0 - float(x * x + y * y) * 0.08);
            sum += texelFetch(raw, at, 0).r * weight;
            total += weight;
        }
    }

    imageStore(result, pixel, vec4(sum / max(total, 1e-4)));
}

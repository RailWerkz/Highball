#version 450

// Pass 3 processes one candidate pixel per thread. Simple corner shapes are blended immediately.
// Complex Z shapes are detected, traced, and added to deferred blend lists.
//
// Z shape work is first encoded in shared memory. After the barrier, all threads share the color
// sampling work. If the shared list is full, BlendZs performs the same work directly. All blending
// uses linear color to match Intel's reference.

#define CMAA2_KERNEL_PROCESS_CANDIDATES 1
#include "cmaa2_common.glsl"

layout (local_size_x = CMAA2_PROCESS_CANDIDATES_NUM_THREADS, local_size_y = 1, local_size_z = 1) in;

void main()
{
    if( gl_LocalInvocationID.x == 0u )
        g_groupSharedBlendItemCount = 0u;
    barrier();

    const uint numCandidates = g_workingControlBuffer[3];
    if( gl_GlobalInvocationID.x < numCandidates )
    {
        uint pixelID = g_workingShapeCandidates[gl_GlobalInvocationID.x];

        // Candidate layout: 14 X bits, 4 unused sample bits, and 14 Y bits.
        ivec2 pixelPos = ivec2( int(pixelID >> 18), int(pixelID & 0x3FFFu) );

        uint edgesCenterPacked = LoadEdge( pixelPos, ivec2( 0, 0 ) );
        vec4 edges      = UnpackEdgesFlt( edgesCenterPacked );
        vec4 edgesLeft  = UnpackEdgesFlt( LoadEdge( pixelPos, ivec2( -1, 0 ) ) );
        vec4 edgesRight = UnpackEdgesFlt( LoadEdge( pixelPos, ivec2(  1, 0 ) ) );
        vec4 edgesBottom= UnpackEdgesFlt( LoadEdge( pixelPos, ivec2( 0,  1 ) ) );
        vec4 edgesTop   = UnpackEdgesFlt( LoadEdge( pixelPos, ivec2( 0, -1 ) ) );

        // Blend simple corner shapes.
        {
            // Candidate selection already confirmed that this is a valid simple shape.
            vec4 blendVal = ComputeSimpleShapeBlendValues( edges, edgesLeft, edgesRight, edgesTop, edgesBottom, true );

            const float fourWeightSum = dot( blendVal, vec4( 1, 1, 1, 1 ) );
            const float centerWeight = 1.0 - fourWeightSum;

            vec3 outColor = LoadSourceColorLinear( pixelPos, ivec2( 0, 0 ) ).rgb * centerWeight;
            if( blendVal.x > 0.0 )   // Blend from the left.
            {
                vec3 pixelL = LoadSourceColorLinear( pixelPos, ivec2( -1, 0 ) ).rgb;
                outColor.rgb += blendVal.x * pixelL;
            }
            if( blendVal.y > 0.0 )   // Blend from above.
            {
                vec3 pixelT = LoadSourceColorLinear( pixelPos, ivec2( 0, -1 ) ).rgb;
                outColor.rgb += blendVal.y * pixelT;
            }
            if( blendVal.z > 0.0 )   // Blend from the right.
            {
                vec3 pixelR = LoadSourceColorLinear( pixelPos, ivec2( 1, 0 ) ).rgb;
                outColor.rgb += blendVal.z * pixelR;
            }
            if( blendVal.w > 0.0 )   // Blend from below.
            {
                vec3 pixelB = LoadSourceColorLinear( pixelPos, ivec2( 0, 1 ) ).rgb;
                outColor.rgb += blendVal.w * pixelB;
            }

            StoreColorSample( pixelPos, outColor, false );
        }

        // Detect complex Z shapes.
        {
            float invertedZScore;
            float normalZScore;
            float maxScore;
            bool horizontal = true;
            bool invertedZ = false;
            // Lower scores indicate a stronger Z shape match.

            // Test the horizontal orientation.
            {
                vec4 edgesM1P0 = edgesLeft;
                vec4 edgesP1P0 = edgesRight;
                vec4 edgesP2P0 = UnpackEdgesFlt( LoadEdge( pixelPos, ivec2(  2, 0 ) ) );

                DetectZsHorizontal( edges, edgesM1P0, edgesP1P0, edgesP2P0, invertedZScore, normalZScore );
                maxScore = max( invertedZScore, normalZScore );

                if( maxScore > 0.0 )
                {
                    invertedZ = invertedZScore > normalZScore;
                }
            }

            // Test the vertical orientation.
            {
                // Rotate edge channels so the horizontal test can handle vertical shapes.
                vec4 edgesM1P0 = edgesBottom;
                vec4 edgesP1P0 = edgesTop;
                vec4 edgesP2P0 = UnpackEdgesFlt( LoadEdge( pixelPos, ivec2( 0, -2 ) ) );

                DetectZsHorizontal( edges.argb, edgesM1P0.argb, edgesP1P0.argb, edgesP2P0.argb, invertedZScore, normalZScore );
                float vertScore = max( invertedZScore, normalZScore );

                if( vertScore > maxScore )
                {
                    maxScore = vertScore;
                    horizontal = false;
                    invertedZ = invertedZScore > normalZScore;
                }
            }

            if( maxScore > 0.0 )
            {
#if CMAA2_EXTRA_SHARPNESS
                float shapeQualityScore = round( clamp( 4.0 - maxScore, 0.0, 3.0 ) );
#else
                float shapeQualityScore = floor( clamp( 4.0 - maxScore, 0.0, 3.0 ) );
#endif

                const vec2 stepRight = ( horizontal ) ? ( vec2( 1, 0 ) ) : ( vec2( 0, -1 ) );
                float lineLengthLeft, lineLengthRight;
                FindZLineLengths( lineLengthLeft, lineLengthRight, pixelPos, horizontal, invertedZ, stepRight );

                lineLengthLeft  -= shapeQualityScore;
                lineLengthRight -= shapeQualityScore;

                if( ( lineLengthLeft + lineLengthRight ) >= 5.0 )
                {
                    // Use direct processing only when the shared list is full.
                    if( !CollectBlendZs( pixelPos, horizontal, invertedZ, shapeQualityScore, lineLengthLeft, lineLengthRight, stepRight ) )
                        BlendZs( pixelPos, horizontal, invertedZ, shapeQualityScore, lineLengthLeft, lineLengthRight, stepRight );
                }
            }
        }
    }

    // All threads share the deferred Z shape work after this barrier.
    barrier();

    uint totalItemCount = min( uint(CMAA2_BLEND_ITEM_SLM_SIZE), g_groupSharedBlendItemCount );

    // Distribute shared items across the workgroup.
    uint loops = ( totalItemCount + uint(CMAA2_PROCESS_CANDIDATES_NUM_THREADS - 1) - gl_LocalInvocationID.x ) / uint(CMAA2_PROCESS_CANDIDATES_NUM_THREADS);

    for( uint loopIndex = 0u; loopIndex < loops; loopIndex++ )
    {
        uint index              = loopIndex * uint(CMAA2_PROCESS_CANDIDATES_NUM_THREADS) + gl_LocalInvocationID.x;

        uvec2 itemVal           = g_groupSharedBlendItems[index];

        ivec2 startingPos       = ivec2( int(itemVal.x >> 18), int(itemVal.x & 0x3FFFu) );

        bool itemHorizontal     = ( (itemVal.y >> 31) & 1u ) != 0u;
        bool itemInvertedZ      = ( (itemVal.y >> 30) & 1u ) != 0u;
        float itemStepIndex     = float( (itemVal.y >> 20) & 0x3FFu ) - 256.0;
        float itemSrcOffset     = float( (itemVal.y >> 10) & 0x3FFu ) - 256.0;
        float itemLerpK         = float( itemVal.y & 0x3FFu ) / 1023.0;

        vec2 itemStepRight      = ( itemHorizontal ) ? ( vec2( 1, 0 ) ) : ( vec2( 0, -1 ) );
        vec2 itemBlendDir       = ( itemHorizontal ) ? ( vec2( 0, -1 ) ) : ( vec2( -1, 0 ) );
        if( itemInvertedZ )
            itemBlendDir = -itemBlendDir;

        ivec2 itemPixelPos      = ivec2( vec2(startingPos) + itemStepRight * itemStepIndex );

        vec3 colorCenter        = LoadBlendColorLinear( itemPixelPos );
        vec3 colorFrom          = LoadBlendColorLinear( itemPixelPos + ivec2( itemBlendDir * itemSrcOffset ) );

        vec3 outputColor        = mix( colorCenter.rgb, colorFrom.rgb, itemLerpK );

        StoreColorSample( itemPixelPos, outputColor, true );
    }
}

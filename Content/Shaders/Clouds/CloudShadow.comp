#version 450
// How much sun gets through the clouds to the ground round the camera, seen from above. A cheap stand-in for Kitten Space Agency's
// shadow volume, enough for shadows drifting over the land. Red is the light that's left.

#include "Clouds/CloudData.glsl"
#include "Clouds/CloudDensity.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D result;

#define STEPS 6

// How much cloud of a layer lies along the sun's ray from a point on the ground.
float AlongLayer(int index, vec3 from, vec3 sun)
{
    vec4 heights = clouds.layers[index].heights;
    float start = max(SphereHits(from, sun, EarthRadius + heights.x).y, 0.0);
    float end = SphereHits(from, sun, EarthRadius + heights.y).y;
    float step = max(end - start, 0.0) / float(STEPS);

    float total = 0.0;
    for (int i = 0; i < STEPS; i++)
    {
        float dimensional, noiseDepth, h;
        total += step * CloudDensity(index, from + sun * (start + (float(i) + 0.5) * step), 2.0, dimensional, noiseDepth, h);
    }

    return total;
}

void main()
{
    ivec2 size = imageSize(result);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 across = (uv * 2.0 - 1.0) * clouds.frame.w + clouds.ground.zw;
    vec3 from = vec3(across.x, clouds.ground.x, across.y);
    vec3 sun = clouds.sun.xyz;

    float total = 0.0;
    int count = int(clouds.ground.y);
    for (int i = 0; i < count; i++)
        total += AlongLayer(i, from, sun);

    // Light scattered through a cloud still arrives: an overcast sky doesn't throw black shadows.
    float lit = BeerAbsorptionMultipleScattering(total);

    if (clouds.high.z > -0.5 && clouds.high.y > 0.0)
    {
        float at = SphereHits(from, sun, EarthRadius + clouds.high.x).y;
        if (at > 0.0)
            lit *= 1.0 - 0.5 * HighCloudCover(from + sun * at, 2.0);
    }

    imageStore(result, pixel, vec4(mix(0.3, 1.0, lit), 0.0, 0.0, 1.0));
}

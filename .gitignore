bin/
obj/
.vs/
.idea/
*.user
publish/
__pycache__/
*.pyc
*.blend1

# Logs and OS leftovers
*.log
*.tmp
Thumbs.db
Desktop.ini
.DS_Store
*.blend2

# Routes are working data, kept on each machine, not in git
Content/Routes/

# Train and lineside audio: too big for git, and not all of it ours to publish
Content/Audio/

# Downloaded source models and what the Blender scripts build from them
Content/Meshes/**/Source/
Content/Meshes/**/Assembled/*.blend
# The vegetation pack's high-res version: the game loads the 1k one
Content/Meshes/Vegetation/low_poly_vegetation_for_games_4k.glb

# Terrain textures nothing loads
Content/Terrain/Modifiers/

# Downloads and unpacked third-party packs that content is made from (Tools/Content/migrate_meshes.py)
ContentSource/

# Exported packs and server track, made from the routes
Export/
# Installed packs, made by the export
Content/Packs/

# Train sound source packs: too big for git, and not all of it ours to publish
Tools/Audio/**/*.wav
.claude/worktrees/

# Vehicle LODs: made from each LOD0 model by Tools/Blender/lods.py
Content/Meshes/**/LOD1/
Content/Meshes/**/LOD2/

# The grass and flowers: under Sketchfab's Standard licence, which doesn't allow handing the model itself out; kept on each machine
Content/Meshes/Vegetation/grass_1k.glb
Content/Meshes/Vegetation/grass_2k.glb

# Trainz packs the freight cars are built from (Tools/RollingStock/build_game.py), if any are dropped in Content
Content/Meshes/**/*.cdp
